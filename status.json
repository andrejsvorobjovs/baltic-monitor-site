    },
    {
      "ts": "2026-09-01T19:06:18.290547+00:00",
      "title": "New: faster early warning between full scans",
      "text": "New: faster checks between full scans."
    },
    {
      "ts": "2026-09-01T18:59:36.432424+00:00",
      "title": "Fewer, better alerts",
      "text": "Fewer, better alerts: repeated coverage of one story no longer re-alerts."
