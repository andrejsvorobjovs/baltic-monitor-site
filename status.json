  "recent_corrections": [
    {
      "ts": "2026-08-05T01:41:20.517203+00:00",
      "text": "A recent WATCH-level flag was wrong: a story about Latvia sending about 20 soldiers to the Strait of Hormuz was mistakenly flagged as a Baltic security signal. This one was a genuine deployment, not a keyword-matching error like the wildfire correction below \u2014 but it's Latvia's own contribution to an international coalition maritime security mission on the other side of the world, with no connection to Russia or the Baltic region. The scoring gap that let this through (a Baltic country's own unrelated foreign deployments passing as a Baltic security signal) has been fixed. As always, the false positive stays in the historical record rather than being quietly deleted.",
      "context": "Latvia plans to send about 20 soldiers to Strait of Hormuz \u2014 flagged WATCH, 2026-08-04"
    },
    {
      "ts": "2026-08-04T20:45:44.779097+00:00",
      "text": "A recent WATCH-level flag was wrong: a story about Lithuania sending firefighters to help France fight wildfires was mistakenly flagged as a Baltic security signal. Cause: a scoring bug \u2014 generic words like 'deployed' and 'reinforcements' (meant to catch real troop movements) were also matching ordinary disaster-response language. That bug, and several similar ones found in a full audit of the scoring keywords, has been fixed. The false positive stays in the historical record below rather than being quietly deleted \u2014 see our policy on this.",
      "context": "Lithuania sends 32 firefighters to help France fight wildfires \u2014 flagged WATCH, 2026-08-01"
    }
  ],
